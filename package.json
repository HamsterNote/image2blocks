{
  "name": "image2blocks",
  "version": "0.1.0",
  "description": "TS + Vite library to binarize, dilate and extract connected components using image-js (browser & Node)",
  "keywords": [
    "image",
    "connected-components",
    "binarize",
    "dilation",
    "image-js",
    "vite",
    "typescript"
  ],
  "license": "MIT",
  "main": "dist/image2blocks.cjs.js",
  "module": "dist/image2blocks.es.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/image2blocks.es.js",
      "require": "./dist/image2blocks.cjs.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite",
    "clean": "rimraf dist",
    "lint": "eslint .",
    "test": "jest"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@types/jest": "^29.5.14",
    "canvas": "^2.11.2",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-sonarjs": "^0.25.1",
    "globals": "^15.9.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "prettier": "^3.3.3",
    "prettier-config-standard": "^7.0.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.10"
  },
  "peerDependencies": {
    "image-js": "^0.35.5"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
